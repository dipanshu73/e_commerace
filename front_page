<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Fashion Store - Mega Sale</title>
  <link rel="stylesheet" href="style.css">
  <style>
    body { font-family: 'Poppins', sans-serif; margin: 0; background-color: #fff; }
    .hero-banner {
      background: linear-gradient(to right, #ff4b2b, #ff416c);
      color: white; text-align: center; padding: 60px 20px;
    }
    .hero-banner h1 { font-size: 48px; margin-bottom: 10px; }
    .hero-banner p { font-size: 20px; margin-bottom: 30px; }
    .btn-shop {
      background-color: white; color: #ff416c; border: none;
      padding: 15px 30px; font-size: 18px; border-radius: 30px;
      cursor: pointer; font-weight: bold;
    }
    .offers {
      display: flex; justify-content: center; flex-wrap: wrap;
      gap: 20px; margin: 40px 0;
    }
    .offer-box {
      background-color: #f8f8f8; border-radius: 10px; width: 300px;
      text-align: center; padding: 20px; box-shadow: 0 4px 8px rgba(0,0,0,0.1);
    }
    .offer-box img { width: 100%; border-radius: 10px; }
    .offer-box h3 { color: #333; margin: 15px 0 10px; }
    .offer-box p { color: #777; font-size: 16px; }
    .offer-btn {
      background-color: #ff416c; color: white; border: none;
      padding: 10px 20px; border-radius: 5px; cursor: pointer;
    }
    footer {
      background-color: #222; color: white; text-align: center;
      padding: 20px; font-size: 14px;
    }
  </style>
</head>
<body>

  <div class="hero-banner">
    <h1>MEGA SAVINGS SALE</h1>
    <p>Flat ₹300 OFF on your first purchase!</p>
    <button class="btn-shop">SHOP NOW</button>
  </div>

  <div class="offers">
    <div class="offer-box">
      <img src="images/red-saree.webp" alt="Red Saree">
      <h3>Red Saree</h3>
      <p>50–80% OFF | Limited Time</p>
      <button class="offer-btn">Buy Now</button>
    </div>

    <div class="offer-box">
      <img src="images/blue-kurti.webp" alt="Blue Kurti">
      <h3>Blue Kurti</h3>
      <p>Trendy Styles | Mega Discount</p>
      <button class="offer-btn">Buy Now</button>
    </div>

    <div class="offer-box">
      <img src="images/party-dress.webp" alt="Party Dress">
      <h3>Party Dress</h3>
      <p>New Arrivals | Hot Deals</p>
      <button class="offer-btn">Buy Now</button>
    </div>
  </div>

  <footer>
    © 2026 Fashion Store | Designed with by Diya Adhikari
  </footer>

</body>
</html>
